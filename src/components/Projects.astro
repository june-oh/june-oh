---
import { getConfig, getLang } from "../i18n";
import ProjectCard from "./ProjectCard.astro";

const siteConfig = getConfig(Astro.url);
const lang = getLang(Astro.url);
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const featuredProjects = siteConfig.projects?.filter((p) => p.featured) ?? [];
const otherProjects = siteConfig.projects?.filter((p) => !p.featured) ?? [];

const labels = {
  section: lang === "ko" ? "연구 프로젝트" : "Research Projects",
  featured: lang === "ko" ? "주요 프로젝트" : "Featured Projects",
  more: lang === "ko" ? "더 보기" : "More Research Projects",
  paper: lang === "ko" ? "논문" : "Paper",
  partner: lang === "ko" ? "협력" : "Partner",
};
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50 dark:bg-slate-800">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-gray-100">
              {labels.section}
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8 space-y-8">
            {featuredProjects.length > 0 && (
              <div class="space-y-4">
                <h3
                  class="text-sm font-bold uppercase tracking-wider"
                  style={{ color: siteConfig.accentColor }}
                >
                  {labels.featured}
                </h3>
                <div class="space-y-6">
                  {featuredProjects.map((project, index) => (
                    <ProjectCard
                      project={project}
                      index={index}
                      accent={true}
                      accentColor={siteConfig.accentColor}
                      partnerLabel={labels.partner}
                      paperLabel={labels.paper}
                    />
                  ))}
                </div>
              </div>
            )}

            {otherProjects.length > 0 && (
              <details class="group">
                <summary class="cursor-pointer list-none flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition-colors select-none">
                  <svg
                    class="w-5 h-5 transition-transform group-open:rotate-90"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                  <span class="text-base sm:text-lg font-semibold">
                    {labels.more}
                    <span class="ml-1 text-sm font-normal text-gray-500 dark:text-gray-400">
                      ({otherProjects.length})
                    </span>
                  </span>
                </summary>
                <div class="mt-6 space-y-6">
                  {otherProjects.map((project, index) => (
                    <ProjectCard
                      project={project}
                      index={index}
                      accent={false}
                      accentColor={siteConfig.accentColor}
                      partnerLabel={labels.partner}
                      paperLabel={labels.paper}
                    />
                  ))}
                </div>
              </details>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
